# Local-dev image — mounts source, no multi-stage/asset-precompile steps.
# The other Dockerfile (Rails-generated) is for production/Kamal; see docs/ARCHITECTURE.md.
FROM ruby:3.4.10-slim

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      build-essential libpq-dev libyaml-dev git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
