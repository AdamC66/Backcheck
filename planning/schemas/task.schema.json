{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "epic_id", "title", "status"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/ticketId" },
    "epic_id": { "$ref": "common.schema.json#/$defs/ticketId" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["feature", "chore", "spike", "bug"],
      "default": "feature"
    },
    "status": { "$ref": "common.schema.json#/$defs/workflowStatus" },
    "priority": { "$ref": "common.schema.json#/$defs/priority" },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional. Only worth listing when 'done' is genuinely ambiguous without them — keep tickets lightweight."
    },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
