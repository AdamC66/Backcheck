{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epic.schema.json",
  "title": "Epic",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project_id", "title", "status"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/ticketId" },
    "project_id": { "$ref": "common.schema.json#/$defs/slug" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": { "$ref": "common.schema.json#/$defs/workflowStatus" },
    "priority": { "$ref": "common.schema.json#/$defs/priority" },
    "blocked_reason": {
      "type": "string",
      "description": "Required in practice when status is 'blocked' — not schema-enforced, keep it honest."
    },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
